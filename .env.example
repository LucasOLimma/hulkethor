# Copie este arquivo para .env.local e preencha com os valores do seu projeto.
# Onde achar: painel do Supabase > Project Settings > API Keys (ou "Data API").
#
# Use SOMENTE a chave PUBLICA (publishable "sb_publishable_..." ou a antiga "anon").
# NUNCA coloque aqui a chave service_role / secret: ela ignora toda a seguranca do banco.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereco do site (usado no link do e-mail de recuperacao de senha).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
