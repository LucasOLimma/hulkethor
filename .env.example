# Copie este arquivo para .env.local e preencha com os valores do seu projeto.
# Onde achar: painel do Supabase > Project Settings > API Keys (ou "Data API").
#
# Nas variaveis NEXT_PUBLIC_ use SOMENTE a chave PUBLICA (publishable "sb_publishable_..."
# ou a antiga "anon"). Elas vao para o navegador. A chave secreta fica so no fim do arquivo.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereco do site (usado no link do e-mail de recuperacao de senha).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# CHAVE SECRETA (so para o SERVIDOR) — usada apenas para convidar pessoas da
# equipe e mostrar o e-mail delas. Onde achar: Project Settings > API Keys >
# "Secret keys" (sb_secret_...) ou, nas chaves antigas, "service_role".
# NUNCA coloque NEXT_PUBLIC_ na frente deste nome: isso enviaria a chave ao navegador.
# Nunca cole esta chave em chat, print ou e-mail.
SUPABASE_SECRET_KEY=
